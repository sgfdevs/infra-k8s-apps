# Localhost URLs are intentional for the private port-forward deployment.
OCIS_URL=http://localhost:9200
OCIS_CONFIG_DIR=/var/lib/ocis/config
OCIS_BASE_DATA_PATH=/var/lib/ocis
OCIS_LOG_LEVEL=info
OCIS_LOG_COLOR=false
OCIS_LOG_PRETTY=false
OCIS_INSECURE=false
OCIS_EXCLUDE_RUN_SERVICES=idp
OCIS_ADD_RUN_SERVICES=notifications
OCIS_DEBUG_ADDR=0.0.0.0:9205
PROXY_HTTP_ADDR=0.0.0.0:9200
PROXY_TLS=false
PROXY_ENABLE_BASIC_AUTH=false
PROXY_AUTOPROVISION_ACCOUNTS=true
PROXY_AUTOPROVISION_CLAIM_USERNAME=sub
PROXY_AUTOPROVISION_CLAIM_EMAIL=email
PROXY_AUTOPROVISION_CLAIM_DISPLAYNAME=name
PROXY_USER_OIDC_CLAIM=sub
PROXY_USER_CS3_CLAIM=username
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=owncloud_roles
PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt
PROXY_OIDC_REWRITE_WELLKNOWN=true
PROXY_CSP_CONFIG_FILE_LOCATION=/var/lib/ocis/config/csp.yaml
GRAPH_LDAP_SERVER_WRITE_ENABLED=true
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
GRAPH_USERNAME_MATCH=none
IDM_CREATE_DEMO_USERS=false
WEB_OIDC_SCOPE=openid profile email offline_access
MICRO_REGISTRY=nats-js-kv
MICRO_REGISTRY_ADDRESS=127.0.0.1:9233
NATS_NATS_HOST=127.0.0.1
NATS_NATS_STORE_DIR=/var/lib/ocis/nats
STORAGE_USERS_DRIVER=s3ng
STORAGE_USERS_S3NG_ENDPOINT=http://seaweedfs-s3.seaweedfs.svc.cluster.local:8333
STORAGE_USERS_S3NG_REGION=us-east-1
STORAGE_USERS_S3NG_BUCKET=owncloud-files
STORAGE_SYSTEM_DRIVER=ocis
COLLABORATION_GRPC_ADDR=127.0.0.1:9301
COLLABORATION_HTTP_ADDR=0.0.0.0:9300
COLLABORATION_DEBUG_ADDR=0.0.0.0:9304
COLLABORATION_WOPI_SRC=http://owncloud.owncloud.svc.cluster.local:9300
COLLABORATION_APP_NAME=CollaboraOnline
COLLABORATION_APP_PRODUCT=Collabora
COLLABORATION_APP_ADDR=http://collabora.owncloud.svc.cluster.local:9980
COLLABORATION_APP_ICON=http://localhost:9980/favicon.ico
FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR=com.owncloud.api.collaboration.CollaboraOnline
NOTIFICATIONS_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_SENDER=ownCloud <files@sgf.dev>
NOTIFICATIONS_SMTP_AUTHENTICATION=login
NOTIFICATIONS_SMTP_ENCRYPTION=starttls
NOTIFICATIONS_SMTP_INSECURE=false
