GLITCHTIP_VERSION=6.2.3
GLITCHTIP_DOMAIN=https://glitchtip.sgf.dev
OIDC_CLIENT_ID=glitchtip
OIDC_DISCOVERY_URL=https://dex.sgf.dev/.well-known/openid-configuration
ALLOWED_HOSTS=glitchtip.sgf.dev,localhost,glitchtip,glitchtip.glitchtip.svc.cluster.local
CSRF_TRUSTED_ORIGINS=https://glitchtip.sgf.dev
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
ENVIRONMENT=production
ENABLE_USER_REGISTRATION=false
ENABLE_SOCIAL_APPS_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=false
GLITCHTIP_RETENTION_DAYS=30
GLITCHTIP_ENABLE_DUCKDB=false
GLITCHTIP_EMBED_WORKER=true
SKIP_INIT=true
GRANIAN_WORKERS=1
GRANIAN_WORKERS_MAX_RSS=384
GRANIAN_WORKERS_KILL_TIMEOUT=30
VTASKS_CONCURRENCY=5
DATABASE_URL=postgresql://glitchtip@glitchtip-db-rw:5432/glitchtip?sslmode=require
DATABASE_HOST=glitchtip-db-rw
DATABASE_PORT=5432
DATABASE_NAME=glitchtip
DATABASE_USER=glitchtip
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
VALKEY_URL=
REDIS_URL=
DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage
AWS_STORAGE_BUCKET_NAME=glitchtip-uploads
AWS_S3_ENDPOINT_URL=http://seaweedfs-s3.seaweedfs.svc.cluster.local:8333
AWS_S3_USE_SSL=false
AWS_DEFAULT_REGION=us-east-1
MEDIA_URL=/uploads/
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
ENABLE_OBSERVABILITY_API=true
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/code
